{{- if eq (includeTemplate "osid" .) "fedora" -}}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "fedora",
    "color": { "1": "#e49b5d", "2": "#ece1d7" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  \u25b8  ",
    "color": { "keys": "#e49b5d", "title": "#85b695", "separator": "#867462" }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "#85b695", "at": "#867462", "host": "#89b3b6" } },
    { "type": "separator", "string": "\u2500" },
    { "type": "os", "key": "\uf30a OS      " },
    { "type": "board", "key": "\uf2db Board   " },
    { "type": "kernel", "key": "\uf013 Kernel  " },
    { "type": "uptime", "key": "\uf017 Uptime  " },
    { "type": "packages", "key": "\uf487 Packages" },
    { "type": "shell", "key": "\uf489 Shell   " },
    { "type": "de", "key": "\uf108 DE      " },
    { "type": "wm", "key": "\uf2d2 WM      " },
    { "type": "terminal", "key": "\ue795 Terminal" },
    { "type": "display", "key": "\uf26c Display " },
    { "type": "cpu", "key": "\uf4bc CPU     " },
    { "type": "gpu", "key": "\udb82\udcae GPU     " },
    { "type": "memory", "key": "\uefc5 Memory  " },
    { "type": "swap", "key": "\uf0ec Swap    " },
    { "type": "disk", "key": "\uf0a0 Disk    ", "folders": "/" },
    { "type": "localip", "key": "\uf0ac Local IP", "showIpv6": false },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
{{- else -}}
{
  "logo": {
    "type": "small"
  },
  "display": {
    "separator": "  \u25b8  ",
    "color": {
      "keys": "cyan",
      "title": "green"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
{{- end }}
