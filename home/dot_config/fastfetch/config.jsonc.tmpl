{{- if eq (includeTemplate "osid" .) "fedora" -}}
// The rail: no logo, the same ╭─ ├─ ╰─ lines and clay grey as the Starship
// prompt, so the summary reads as the first prompt's header. Only live state
// (temperatures, GPU memory, memory, disk) besides one line of system facts.
// About 50 columns wide; narrower windows get ~/.local/share/dotfiles/fetch-strip.
{
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#AE9FDB"
    },
    "size": {
      "ndigits": 1
    },
    "temp": {
      "ndigits": 0
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 10,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "ndigits": 0,
      "width": 3,
      "color": {
        "green": "#8FB39A",
        "yellow": "#D9B26F",
        "red": "#E08C8C"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "{#38;2;134;116;98}╭─",
      "format": "{#1;38;2;133;182;149}{user-name}{#0;38;2;134;116;98}@{#38;2;137;179;182}{host-name}"
    },
    {
      "type": "custom",
      "format": "{#38;2;134;116;98}│"
    },
    {
      "type": "command",
      "key": "{#38;2;134;116;98}├─{#38;2;228;155;93} sys ",
      "text": ". /etc/os-release; printf '%s %s \\033[38;2;134;116;98m·\\033[0m linux %s' \"$NAME\" \"$VERSION_ID\" \"$(uname -r | cut -d- -f1)\""
    },
    {
      "type": "uptime",
      "key": "{#38;2;134;116;98}├─{#38;2;228;155;93} up  ",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    {
      "type": "cpu",
      "key": "{#38;2;134;116;98}├─{#38;2;228;155;93} cpu ",
      "temp": true,
      "format": "{name} {#38;2;134;116;98}·{#0} {cores-logical}t {#38;2;134;116;98}·{#0} {temperature}"
    },
    {
      "type": "gpu",
      "key": "{#38;2;134;116;98}├─{#38;2;228;155;93} gpu ",
      "temp": true,
      "driverSpecific": true,
      "format": "{dedicated-percentage-bar} {dedicated-percentage-num}  {dedicated-used} / {dedicated-total} {#38;2;134;116;98}·{#0} {temperature}"
    },
    {
      "type": "memory",
      "key": "{#38;2;134;116;98}├─{#38;2;228;155;93} mem ",
      "format": "{percentage-bar} {percentage}  {used} / {total}"
    },
    {
      "type": "disk",
      "key": "{#38;2;134;116;98}╰─{#38;2;228;155;93} dsk ",
      "folders": "/",
      "format": "{size-percentage-bar} {size-percentage}  {size-used} / {size-total}"
    }
  ]
}
{{- else -}}
{
  "logo": {
    "type": "small"
  },
  "display": {
    "separator": "  \u25b8  ",
    "color": {
      "keys": "cyan",
      "title": "green"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
{{- end }}
