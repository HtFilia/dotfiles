# ~/.config/kitty/kitty.conf
# Kitty terminal: Dusk palette, Fira Code, splits.
# Kitty bundles the Nerd Font symbols used by Starship and eza.

# Font
font_family      family="Fira Code" features=+ss01
font_size        12.0
# Nerd Font icons (Private Use Areas, Material Design included) always come
# from the Symbols Nerd Font Mono that Kitty bundles. Without this, fontconfig
# fallback picks the first installed font that covers a codepoint: on Fedora,
# the Tibetan font Jomolhari takes U+F086F, eza's icon for private keys, and
# the proportional Symbols Nerd Font takes the other icons.
symbol_map       U+E000-U+F8FF,U+F0001-U+F1AF0 Symbols Nerd Font Mono

# Dusk palette (lavender and dusk rose on warm charcoal): colours, tabs and
# split borders come from dusk.conf, generated from the Alpenglow & Dusk
# palette. Edit the palette, not that file.
include dusk.conf

# Tabs on top, coloured like the tmux status line.
tab_bar_edge             top

# Window: translucent background, blurred on KDE Plasma.
background_opacity    0.97
background_blur       12
window_padding_width  14 16
cursor_shape          beam
scrollback_lines      100000
mouse_hide_wait       -1
copy_on_select        clipboard
shell_integration     enabled
# Open zsh even when the desktop session started before `chsh`: it keeps
# SHELL=/bin/bash until the next login, and Kitty would start bash.
shell                 zsh

# Shortcuts that differ from Kitty's defaults.
enabled_layouts splits,stack
map ctrl+shift+t     new_tab_with_cwd
map ctrl+shift+d     launch --location=vsplit --cwd=current
map ctrl+shift+e     launch --location=hsplit --cwd=current
map ctrl+alt+left    neighboring_window left
map ctrl+alt+right   neighboring_window right
map ctrl+alt+up      neighboring_window up
map ctrl+alt+down    neighboring_window down
map ctrl+plus        change_font_size all +1.0
map ctrl+equal       change_font_size all +1.0
map ctrl+minus       change_font_size all -1.0
map ctrl+0           change_font_size all 0
map ctrl+shift+k     clear_terminal reset active
{{- if eq (includeTemplate "osid" .) "fedora" }}
# URL hints next to Kitty's other Ctrl+Shift+P hints (f path, l line, h hash,
# w word); Ctrl+Shift+E, their default, opens a split here.
map ctrl+shift+p>u   open_url_with_hints
{{- end }}

# Machine-specific settings, such as a font size for one screen.
globinclude kitty.d/*.conf
