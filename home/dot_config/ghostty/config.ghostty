# ~/.config/ghostty/config.ghostty
# Ghostty terminal — https://ghostty.org/docs/config
# Theme: Operator

# ============================================================================
# FONT
# ============================================================================
font-family = "FiraCode Nerd Font Mono"
font-size = 14
font-feature = +calt
font-feature = +liga
font-feature = +ss01
font-thicken = true

# ============================================================================
# THEME - Operator
# ============================================================================

# 16-color palette (Operator)

# ============================================================================
# WINDOW
# ============================================================================
window-decoration = true
window-theme = dark
confirm-close-surface = true
window-save-state = always
macos-titlebar-style = tabs

# ============================================================================
# CURSOR
# ============================================================================
shell-integration = detect
shell-integration-features = cursor,sudo,title,path,ssh-env,ssh-terminfo
# Keep the right Option key available for accented characters on macOS.
macos-option-as-alt = left

# ============================================================================
# SCROLLING
# ============================================================================
# Bytes, not lines: reserve 64 MiB for local scrollback.
scrollback-limit = 67108864
mouse-hide-while-typing = true
copy-on-select = clipboard

# ============================================================================
# KEYBINDINGS
# ============================================================================
# Tabs
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Splits
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:top
keybind = ctrl+alt+down=goto_split:bottom

# Font size
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Clear
keybind = ctrl+shift+k=clear_screen


background = 142727
foreground = e5f0ea
cursor-color = e5bc70
cursor-style = bar
cursor-style-blink = true
selection-background = 294742
selection-foreground = e5f0ea
background-opacity = 0.97
background-blur = 12
window-padding-x = 16
window-padding-y = 14
window-padding-balance = true
palette = 0=#142727
palette = 1=#e98a8a
palette = 2=#75d1c2
palette = 3=#e5bc70
palette = 4=#9db9d6
palette = 5=#b8a7d9
palette = 6=#75d1c2
palette = 7=#e5f0ea
palette = 8=#55736d
palette = 9=#f0a1a1
palette = 10=#9be2d6
palette = 11=#f2d08e
palette = 12=#b8cde3
palette = 13=#cbbde6
palette = 14=#9be2d6
palette = 15=#f7fbf8
