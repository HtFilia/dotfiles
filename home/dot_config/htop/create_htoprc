# Native htop settings; delay is measured in tenths of a second.
# Black Night uses the terminal palette and works with Operator's dark background.
color_scheme=5
delay=5
hide_kernel_threads=1
hide_userland_threads=1
show_program_path=0
highlight_base_name=1
highlight_megabytes=1
show_cpu_usage=1
show_cpu_frequency=0
header_margin=1
screen_tabs=0
enable_mouse=1
header_layout=two_50_50
column_meters_0=AllCPUs2 Memory Swap
column_meter_modes_0=1 1 1
column_meters_1=Hostname Tasks LoadAverage Uptime
column_meter_modes_1=2 2 2 2
screen:Main=PID USER STATE PERCENT_CPU PERCENT_MEM M_RESIDENT TIME Command
.sort_key=PERCENT_CPU
.sort_direction=-1
.tree_view=0
