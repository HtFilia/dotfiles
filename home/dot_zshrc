#!/usr/bin/env zsh
# ~/.zshrc - managed by dotfiles/scripts/apply-dotfiles.sh
# shellcheck disable=all

case "$OSTYPE" in
  darwin*) export DOTFILES_OS=macos ;;
  linux*)
    export DOTFILES_OS=linux
    [[ -n "${WSL_DISTRO_NAME:-}" ]] && export DOTFILES_OS=wsl
    ;;
  *) export DOTFILES_OS=unknown ;;
esac
# Inputs are read before integrations; final overrides remain in .zshrc.local.
[[ -f "$HOME/.zshrc.settings" ]] && source "$HOME/.zshrc.settings"
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/go/bin" $path)
for _prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
  if [[ -x "$_prefix/bin/brew" ]]; then
    export HOMEBREW_PREFIX="$_prefix"
    path=("$_prefix/bin" "$_prefix/sbin" $path)
    fpath=("$_prefix/share/zsh/site-functions" $fpath)
    [[ -d "$_prefix/opt/node/bin" ]] && path=("$_prefix/opt/node/bin" $path)
    [[ -d "$_prefix/opt/python@3.14/libexec/bin" ]] && path=("$_prefix/opt/python@3.14/libexec/bin" $path)
    break
  fi
done
unset _prefix
export PATH
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export LESS="-R --mouse --wheel-lines=3"
if [[ "$DOTFILES_OS" == macos ]]; then
  export LANG="${LANG:-en_US.UTF-8}"
else
  export LANG="${LANG:-C.UTF-8}"
fi
command -v bat &>/dev/null && command -v col &>/dev/null && export MANPAGER="sh -c 'col -bx | bat -l man -p'"
# Ghostty and tmux advertise true color; SSH need not forward COLORTERM.
[[ "$TERM" == xterm-ghostty || "$TERM" == tmux-256color ]] && export COLORTERM=truecolor
export BAT_THEME="gruvbox-dark"
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
[[ -e "$HISTFILE" ]] || (umask 077; : >"$HISTFILE")
setopt EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_IGNORE_DUPS HIST_IGNORE_SPACE
setopt HIST_VERIFY SHARE_HISTORY APPEND_HISTORY
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT INTERACTIVE_COMMENTS
setopt NO_BEEP PROMPT_SUBST

autoload -Uz compinit
compinit
bindkey -e
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

_dotfiles_file_mode() {
  case "$DOTFILES_OS" in
    macos) stat -f '%Lp' "$1" ;;
    *) stat -c '%a' "$1" ;;
  esac
}

_dotfiles_safe_source() {
  local file="$1" base="$2" mode
  [[ -f "$file" && "$file" == "$base"/* ]] || return 1
  local target="${file:A}" directory
  [[ "$target" == "${base:A}"/* ]] || return 1
  directory="$target"
  while [[ "$directory" != "$HOME" && "$directory" != / ]]; do
    [[ -O "$directory" && ! -L "$directory" ]] || return 1
    mode="$(_dotfiles_file_mode "$directory" 2>/dev/null)" || return 1
    [[ -n "$mode" && "$mode" != *[^0-7]* ]] && (( (8#$mode & 8#022) == 0 )) || return 1
    directory="${directory:h}"
  done
  source "$file"
}

ZSH_PLUGIN_DIR="$HOME/.local/share/zsh/plugins"
_dotfiles_safe_source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" "$ZSH_PLUGIN_DIR"
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#928374"

# Saved style can be overridden for this session before starting Zsh.
if [[ -z "${DOTFILES_STYLE:-}" ]]; then
  DOTFILES_STYLE=operator
  [[ ! -f "$HOME/.config/dotfiles/style" ]] || IFS= read -r DOTFILES_STYLE < "$HOME/.config/dotfiles/style"
fi
case "$DOTFILES_STYLE" in operator|studio|neon|matrix|classic) ;; *) DOTFILES_STYLE=operator ;; esac
if [[ "$DOTFILES_STYLE" == classic ]]; then
  export STARSHIP_CONFIG="$HOME/.config/starship.toml"
else
  export STARSHIP_CONFIG="$HOME/.config/dotfiles/styles/$DOTFILES_STYLE/starship.toml"
fi
command -v starship &>/dev/null && eval "$(starship init zsh)"
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
  alias cd='z'
fi
if command -v fzf &>/dev/null; then
  _fzf_init="$(fzf --zsh 2>/dev/null)"
  if [[ -n "$_fzf_init" ]]; then
    eval "$_fzf_init"
  else
    [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
    [[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
    [[ -f ~/.fzf/shell/key-bindings.zsh ]] && source ~/.fzf/shell/key-bindings.zsh
    [[ -f ~/.fzf/shell/completion.zsh ]] && source ~/.fzf/shell/completion.zsh
  fi
  unset _fzf_init
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border=rounded"
  export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS --color=bg:#1d2021,bg+:#282828,fg:#d4be98,fg+:#d4be98,hl:#d8a657,hl+:#d8a657,info:#7daea3,prompt:#a9b665,pointer:#d3869b,marker:#e78a4e,spinner:#89b482,header:#928374,border:#3c3836"
  if command -v fd &>/dev/null; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  fi
fi
if [[ "$DOTFILES_STYLE" == operator ]]; then
  export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS --color=bg:#142727,bg+:#1b3533,fg:#e5f0ea,hl:#75d1c2,hl+:#e5bc70,prompt:#75d1c2,pointer:#e5bc70,border:#294742"
elif [[ "$DOTFILES_STYLE" == studio ]]; then
  export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS --color=bg:#111418,bg+:#1a2026,fg:#d6dde5,hl:#69d1c5,hl+:#e4b86a,prompt:#69d1c5,pointer:#e4b86a,border:#29323b"
elif [[ "$DOTFILES_STYLE" != classic ]]; then
  export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS --color=bg:#080d16,bg+:#132335,fg:#c8e6ee,hl:#59ffb1,hl+:#ff59cf,prompt:#49d7ff,pointer:#ff59cf,border:#245268"
fi
command -v vivid &>/dev/null && export LS_COLORS="$(vivid generate molokai)"
command -v atuin &>/dev/null && eval "$(atuin init zsh --disable-up-arrow)"
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"
command -v mise &>/dev/null && eval "$(mise activate zsh)"

if command -v eza &>/dev/null; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -l --icons --group-directories-first --git'
  alias la='eza -la --icons --group-directories-first --git'
  alias lt='eza --tree --icons --level=2'
  alias ltt='eza --tree --icons --level=3'
fi
if [[ "${DOTFILES_ENABLE_COMMAND_OVERRIDES:-0}" == "1" ]]; then
  command -v bat &>/dev/null && alias cat='bat --paging=never' less='bat'
  command -v rg &>/dev/null && alias grep='rg'
  command -v fd &>/dev/null && alias find='fd'
  alias mkdir='mkdir -p'
fi
command -v lazygit &>/dev/null && alias lg='lazygit'

alias g='git' gs='git status -sb' ga='git add' gaa='git add --all'
alias gc='git commit' gcm='git commit -m' gca='git commit --amend'
alias gco='git checkout' gcb='git checkout -b' gb='git branch'
alias gp='git push' gpl='git pull' gl='git log --oneline --graph --decorate'
alias gll='git log --oneline --graph --decorate --all' gd='git diff'
alias gds='git diff --staged' gst='git stash' gstp='git stash pop'
alias gstl='git stash list' gf='git fetch' gfa='git fetch --all --prune'
alias grb='git rebase' grbi='git rebase -i' gcp='git cherry-pick'
alias grs='git restore' grss='git restore --staged' grt='git rev-parse --show-toplevel'

if command -v docker &>/dev/null; then
  alias d='docker'
  alias dc='docker compose'
  alias dps='docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"'
  alias dpsa='docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}"'
  alias di='docker images' dex='docker exec -it' dlog='docker logs -f'
  alias dprune='docker system prune'
elif command -v podman &>/dev/null; then
  alias d='podman' dc='podman compose' dps='podman ps' di='podman images'
fi

alias ..='cd ..' ...='cd ../..' ....='cd ../../..' -- -='cd -'
alias mkd='mkdir -p' df='df -h' du='du -h'
[[ "$DOTFILES_OS" == macos ]] || alias free='free -h'
alias reload='exec zsh' zshconfig='$EDITOR ~/.zshrc'
alias nvimconfig='$EDITOR ~/.config/nvim'
alias dotfiles='cd "${DOTFILES_DIR:-$HOME/dotfiles}"'
alias dotupdate='dotfiles-update'

if [[ "$DOTFILES_OS" == "macos" ]]; then
  alias showfiles='defaults write com.apple.finder AppleShowAllFiles YES; killall Finder'
  alias hidefiles='defaults write com.apple.finder AppleShowAllFiles NO; killall Finder'
  alias flushdns='sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder'
  alias brewup='brew update && brew upgrade && brew cleanup'
else
  alias aptup='sudo apt update && sudo apt upgrade'
  alias apti='sudo apt install' apts='apt search' aptrm='sudo apt remove'
  alias aptshow='apt show' open='xdg-open'
  alias sc='systemctl' scu='systemctl --user' jcf='journalctl -fu'
  alias jcu='journalctl -u' jcb='journalctl -b'
fi

if [[ "$DOTFILES_OS" == "wsl" ]]; then
  alias pbcopy='clip.exe'
  alias pbpaste='powershell.exe -command "Get-Clipboard" | sed "s/\r//"'
  alias explorer='explorer.exe'
  winhome() {
    local windows_home
    windows_home=$(powershell.exe -NoProfile -Command '$env:USERPROFILE' | tr -d '\r') || return
    builtin cd -- "$(wslpath "$windows_home")"
  }
fi

mkcd() { mkdir -p "$1" && cd "$1" || return; }
extract() {
  if [[ -f "$1" ]]; then
    case "$1" in
      *.tar.bz2) tar xjf "$1" ;; *.tar.gz) tar xzf "$1" ;; *.tar.xz) tar xJf "$1" ;;
      *.bz2) bunzip2 "$1" ;; *.rar) unrar x "$1" ;; *.gz) gunzip "$1" ;;
      *.tar) tar xf "$1" ;; *.tbz2) tar xjf "$1" ;; *.tgz) tar xzf "$1" ;;
      *.zip) unzip "$1" ;; *.Z) uncompress "$1" ;; *.7z) 7z x "$1" ;;
      *) echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}
fe() {
  local file
  IFS= read -r -d $'\0' file < <(fd --type f --print0 | fzf --read0 --print0 --preview 'bat --color=always --style=numbers --line-range=:500 -- {}') || return
  "${EDITOR:-nvim}" -- "$file"
}
fcd() {
  local dir
  IFS= read -r -d $'\0' dir < <(fd --type d --print0 | fzf --read0 --print0) || return
  builtin cd -- "$dir"
}
fga() {
  local file
  local -a files
  while IFS= read -r -d $'\0' file; do files+=("$file"); done < <(
    { git diff --name-only -z; git ls-files --others --exclude-standard -z; } |
      fzf --read0 --print0 --multi --preview 'git diff --color=always -- {}'
  )
  (( ${#files} )) && git add -- "${files[@]}"
}
fkill() {
  local pid
  local -a pids
  while IFS= read -r pid; do pids+=("$pid"); done < <(ps -eo pid=,args= | fzf -m | awk '{print $1}')
  (( ${#pids} )) && kill -s "${1:-TERM}" -- "${pids[@]}"
}
frg() {
  local result file line
  (( $# )) || { print -u2 'Usage: frg PATTERN'; return 1; }
  result=$(rg --json -- "$*" . | jq -r 'select(.type == "match") | [.data.path.text, .data.line_number, .data.lines.text] | @json' | fzf) || return
  [[ -n "$result" ]] || return
  IFS= read -r -d $'\0' file < <(print -r -- "$result" | jq -j '.[0], "\u0000"') || return
  line=$(print -r -- "$result" | jq -r '.[1]')
  "${EDITOR:-nvim}" "+$line" -- "$file"
}
fh() { print -z "$(fc -rln 1 | fzf --no-sort --tac --query="$*")"; }
groot() { local root; root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Not in a git repo."; return 1; }; cd "$root" || return; }
gclone() { local dest="${2:-$(basename "$1" .git)}"; git clone "$1" "$dest" && cd "$dest" || return; }
gwip() { git add -A && git commit -m "wip: $(date '+%Y-%m-%d %H:%M')"; }
gunwip() { git log -1 --format=%s | command grep -Eq "^wip: [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$" && git reset HEAD~1; }
serve() { python3 -m http.server --bind "${2:-127.0.0.1}" "${1:-8000}"; }
psg() { ps aux | grep -v grep | grep -i "$@"; }
activate() {
  if [[ -f .venv/bin/activate ]]; then source .venv/bin/activate
  elif [[ -f venv/bin/activate ]]; then source venv/bin/activate
  else echo "No .venv or venv found. Create with: uv venv"; return 1
  fi
}

if command -v uv &>/dev/null; then
  _uv_cache="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/uv-completion.zsh"
  _uv_command="${commands[uv]:A}"
  _uv_cached_command=""
  [[ ! -f "$_uv_cache.command" ]] || IFS= read -r _uv_cached_command <"$_uv_cache.command"
  if [[ ! -f "$_uv_cache" || "$_uv_command" -nt "$_uv_cache" || "$_uv_command" != "$_uv_cached_command" ]]; then
    mkdir -p "${_uv_cache:h}"
    _uv_stage=$(mktemp "$_uv_cache.XXXXXX")
    if uv generate-shell-completion zsh >"$_uv_stage"; then
      mv "$_uv_stage" "$_uv_cache"
      (umask 077; print -r -- "$_uv_command" >"$_uv_cache.command")
    else
      rm -f "$_uv_stage"
    fi
  fi
  _dotfiles_safe_source "$_uv_cache" "${_uv_cache:h}" || true
  unset _uv_cache _uv_command _uv_cached_command _uv_stage
  alias uvr='uv run' uvs='uv sync' uva='uv add' uvp='uv pip'
  alias pyi='uv pip install' pyls='uv pip list'
fi
yy() {
  local tmp cwd
  tmp=$(mktemp) || return
  yazi "$@" --cwd-file="$tmp"
  [[ ! -s "$tmp" ]] || { cwd=$(cat "$tmp"); builtin cd -- "$cwd"; }
  rm -f "$tmp"
}
tm() { tmux new-session -A -s "${1:-${PWD:t}}"; }
command -v lazydocker &>/dev/null && alias lzd='lazydocker'
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
export GOPATH="${GOPATH:-$HOME/go}"
export GOBIN="${GOBIN:-$GOPATH/bin}"
[[ -d "$GOBIN" ]] && path+=("$GOBIN")
command -v claude &>/dev/null && alias ai='claude' air='claude --resume'
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
# Syntax highlighting must be loaded after widgets from fzf/atuin/local config.
_dotfiles_safe_source "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" "$ZSH_PLUGIN_DIR" || true

# Explicit commands: no animation, network fetch or dashboard at shell startup.
alias lab='dotfiles-lab' deck='dotfiles-deck'
alias helpme='tldr' jsonview='jless'
termstyle() { dotfiles-style "$@" && { print 'Style saved. Run: exec zsh'; }; }
