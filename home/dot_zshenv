# Keep non-interactive SSH commands able to find user-installed tools.
# No subprocesses, terminal output or interactive plugin setup here.
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/go/bin" $path)
export PATH
# LazyGit reads ~/.config/lazygit/config.local.yml after the managed config
# when it exists; it refuses to start when a listed file is missing.
[[ -f "$HOME/.config/lazygit/config.local.yml" ]] &&
  export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/config.local.yml"
# Environment for every zsh on this machine, including non-interactive ones.
[[ -f "$HOME/.zshenv.local" ]] && source "$HOME/.zshenv.local"
