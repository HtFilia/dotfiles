# Melange Dark for KDE Plasma, matching the Kitty, tmux and Starship palette.
# Colours from github.com/savq/melange-nvim (MIT). Plasma copies them into
# kdeglobals when the scheme is applied and passes them on to GTK apps.
#
# Window #2e2a27 sidebars and dialogs     View #292522 lists and text fields
# Header #34302c titlebars and toolbars   Complementary #211d1b panels
# Text #ece1d7, inactive text #a08c78     Accent and selection: clay #e49b5d

[ColorEffects:Disabled]
Color=52,48,44
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

