#!/bin/sh
# Two-line machine summary for Kitty windows too narrow for the fastfetch
# rail. Reads /proc directly, and the GPU memory that starship-vram caches.
clay='\033[38;2;134;116;98m' amber='\033[38;2;228;155;93m'
sage='\033[1;38;2;133;182;149m' teal='\033[38;2;137;179;182m' reset='\033[0m'
dot="${clay}  ·  ${reset}"

up=$(awk '{ d = int($1 / 86400); h = int($1 % 86400 / 3600); m = int($1 % 3600 / 60)
  printf "%s%dh %dm", (d ? d "d " : ""), h, m }' /proc/uptime)
load=$(cut -d' ' -f1 /proc/loadavg)
mem=$(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { printf "%d%%", (t - a) * 100 / t }' /proc/meminfo)
disk=$(df --output=pcent / | tail -n 1 | tr -d ' ')
vram=$(awk -F', *' 'NR == 1 && $2 > 0 { printf "%d%%", $1 * 100 / $2 }' \
  "${XDG_RUNTIME_DIR:-/tmp}/starship-vram-$(id -u)" 2>/dev/null)
# shellcheck source=/dev/null
. /etc/os-release

printf '%b╭─ %b%s%b@%b%s%b%s %s%bup %s\n' "$clay" "$sage" "$(id -un)" "$clay" "$teal" \
  "$(uname -n | cut -d. -f1)" "$dot" "$NAME" "$VERSION_ID" "$dot" "$up"
printf '%b╰─ %bload %b%s' "$clay" "$amber" "$reset" "$load"
printf '%b%bmem %b%s' "$dot" "$amber" "$reset" "$mem"
[ -n "$vram" ] && printf '%b%bvram %b%s' "$dot" "$amber" "$reset" "$vram"
printf '%b%bdisk %b%s%b\n' "$dot" "$amber" "$reset" "$disk" "$reset"
