{{- $osid := includeTemplate "osid" . -}}
{{- if eq .profile "workstation" -}}
#!/usr/bin/env bash
# Install the stable Rust toolchain once, through the packaged rustup.
# rustup downloads the toolchain and checks it against its own manifest.
set -euo pipefail
{{- if eq $osid "fedora" }}

# Fedora's rustup package ships rustup-init, which installs rustup in ~/.cargo.
if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
  echo "Installing rustup and the stable Rust toolchain in ~/.cargo and ~/.rustup."
  rustup-init -y --no-modify-path --default-toolchain stable
fi
{{- else }}

rustup=rustup
if ! "$rustup" toolchain list 2>/dev/null | grep -q '^stable'; then
  echo "Installing the stable Rust toolchain in ~/.rustup."
  "$rustup" default stable
fi
{{- end }}
{{ end -}}
