# Host-specific identities and aliases are loaded for every destination.
Include ~/.ssh/config.local

# GitHub uses the dedicated key in ~/.ssh directly; no agent setup is needed.
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github
    IdentitiesOnly yes
    IdentityAgent none
    AddKeysToAgent no
    PreferredAuthentications publickey
    PasswordAuthentication no
