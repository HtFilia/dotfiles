{{- if and (eq (includeTemplate "osid" .) "fedora") (eq .profile "workstation") -}}
#!/usr/bin/env bash
# Install the Dusk Ridge GRUB theme and make GRUB use it. Runs again when the
# theme files change. The steps marked "sudo" write to /boot and
# /etc/default/grub, then regenerate grub.cfg; the change shows at the next boot.
# theme.txt: {{ include "dot_local/share/boot-theme/grub/theme.txt" | sha256sum }}
# background.png: {{ include "dot_local/share/boot-theme/grub/background.png" | sha256sum }}
set -euo pipefail
source_dir="$HOME/.local/share/boot-theme/grub"
theme_dir=/boot/grub2/themes/dusk-ridge

if [[ ! -d /sys/firmware/efi ]] || ! command -v grub2-mkfont >/dev/null 2>&1; then
  echo "GRUB theme: needs a UEFI Fedora with grub2-tools; skipped."
  exit 0
fi

font_file() {
  local file
  file="$(fc-match -f '%{file}' "$1")"
  [[ -n "$file" ]] && echo "$file" || echo /usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
cp "$source_dir"/* "$work"/
# Inter, falling back to whatever fontconfig matches; the family names are
# fixed by -n so theme.txt does not depend on the font chosen.
grub2-mkfont -s 44 -n "Dusk Title" -o "$work/title-44.pf2" "$(font_file 'Inter:style=SemiBold')" 2>/dev/null
grub2-mkfont -s 28 -n "Dusk Item" -o "$work/item-28.pf2" "$(font_file 'Inter:style=Regular')" 2>/dev/null
grub2-mkfont -s 24 -n "Dusk Item" -o "$work/item-24.pf2" "$(font_file 'Inter:style=Regular')" 2>/dev/null

echo "sudo: install the theme into $theme_dir"
sudo rm -rf "$theme_dir"
sudo install -d -m 755 "$theme_dir"
sudo install -m 644 "$work"/* "$theme_dir"/

set_grub_default() { # key value: replace or append in /etc/default/grub
  if sudo grep -q "^$1=" /etc/default/grub; then
    sudo sed -i "s|^$1=.*|$1=$2|" /etc/default/grub
  else
    echo "$1=$2" | sudo tee -a /etc/default/grub >/dev/null
  fi
}
echo "sudo: point /etc/default/grub at the theme"
set_grub_default GRUB_TERMINAL_OUTPUT '"gfxterm"'
set_grub_default GRUB_THEME "\"$theme_dir/theme.txt\""
set_grub_default GRUB_GFXMODE '"1920x1080,auto"'
set_grub_default GRUB_GFXPAYLOAD_LINUX keep

echo "sudo: regenerate grub.cfg"
sudo grub2-mkconfig -o /boot/grub2/grub.cfg
echo "GRUB theme installed; it shows at the next boot."
{{ end -}}
