[init]
    defaultBranch = main

[core]
    editor = nvim
    autocrlf = input
    pager = delta
    excludesfile = ~/.config/git/ignore
    attributesfile = ~/.config/git/attributes

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    side-by-side = false
    # Syntax colours from the terminal palette (Dusk); line backgrounds are
    # Dusk's soft sage and rose.
    syntax-theme = "ansi"
    plus-style = syntax "#2F3A32"
    plus-emph-style = syntax "#3D5040"
    minus-style = syntax "#45302E"
    minus-emph-style = syntax "#5E3B39"
    features = decorations

[delta "decorations"]
    commit-decoration-style = "#AE9FDB box ul"
    file-style = bold "#E4DDD6"
    file-decoration-style = "#AE9FDB ul"
    hunk-header-decoration-style = "#AE9FDB box"

[merge]
    conflictstyle = zdiff3
    tool = nvim

[mergetool "nvim"]
    cmd = nvim -d \"$LOCAL\" \"$REMOTE\" \"$MERGED\" -c '$wincmd w' -c 'wincmd J'

[diff]
    colorMoved = default
    algorithm = histogram

[pull]
    rebase = true

[push]
    default = current
    autoSetupRemote = true
    followTags = true

# Clone and fetch GitHub over HTTPS, which needs no key; push over SSH with
# the key selected in ~/.ssh/config.
[url "git@github.com:"]
    pushInsteadOf = https://github.com/

[rebase]
    autoStash = true
    autoSquash = true

[fetch]
    prune = true

[color]
    ui = auto

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[help]
    autocorrect = prompt

[rerere]
    enabled = true

[commit]
    verbose = true

[log]
    date = iso

[alias]
    s = status -sb
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all
    last = log -1 HEAD --stat
    undo = reset --soft HEAD^
    amend = commit --amend --no-edit
    br = branch --sort=-committerdate
    cleanup = "!f() { base=${1:-main}; branches=$(git for-each-ref --merged=\"$base\" --format='%(refname:short)' refs/heads) || return; printf '%s\\n' \"$branches\" | while IFS= read -r branch; do case \"$branch\" in \"\"|main|master|develop) continue;; esac; git branch -d -- \"$branch\"; done; }; f"
    aliases = config --get-regexp alias

[include]
    path = ~/.config/git/difftastic
    path = ~/.gitconfig.local
