{{- $osid := includeTemplate "osid" . -}}
{{- if and (eq $osid "debian") (eq .profile "server") .systemBaseline -}}
#!/usr/bin/env bash
# Debian 13 server baseline, applied when this machine answered
# systemBaseline=true: daily unattended upgrades from Debian origins without
# automatic reboot, a persistent journal with bounded retention, and journal
# access for this administrator. The policy files live in .system/debian/;
# changing one changes this script, so the next apply installs it again.
# Replaced files are copied to /var/backups/dotfiles-system first.
set -euo pipefail

journal_policy="$(cat <<'POLICY'
{{ include ".system/debian/20-dotfiles-retention.conf" -}}
POLICY
)"
apt_periodic="$(cat <<'POLICY'
{{ include ".system/debian/20auto-upgrades" -}}
POLICY
)"
unattended_policy="$(cat <<'POLICY'
{{ include ".system/debian/52dotfiles-unattended" -}}
POLICY
)"
user="$(id -un)"
timers=(apt-daily.timer apt-daily-upgrade.timer logrotate.timer)

check="$(mktemp)"
trap 'rm -f "$check"' EXIT
printf '%s\n' "$unattended_policy" >"$check"
apt-config -c "$check" dump >/dev/null

echo "Debian baseline: the following steps use sudo (apt-get, install, usermod, systemctl)."
missing=()
for package in unattended-upgrades logrotate; do
  # shellcheck disable=SC2016
  status="$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)"
  [[ "$status" == "install ok installed" ]] || missing+=("$package")
done
if (( ${#missing[@]} )); then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

sudo install -d -m 0700 /var/backups/dotfiles-system
backup="$(sudo mktemp -d /var/backups/dotfiles-system/baseline.XXXXXXXX)"
# install_policy TARGET CONTENT: write CONTENT to TARGET unless it already
# matches; returns 1 when nothing changed.
install_policy() {
  local target="$1" content="$2"
  if [[ -f "$target" && "$(cat "$target")" == "$content" ]]; then
    return 1
  fi
  if [[ -e "$target" ]]; then
    sudo cp -p "$target" "$backup/"
  fi
  printf '%s\n' "$content" | sudo install -m 0644 /dev/stdin "$target"
  echo "Installed $target"
}
sudo install -d -m 0755 /etc/systemd/journald.conf.d
journal_changed=0
if install_policy /etc/systemd/journald.conf.d/20-dotfiles-retention.conf "$journal_policy"; then
  journal_changed=1
fi
install_policy /etc/apt/apt.conf.d/20auto-upgrades "$apt_periodic" || true
install_policy /etc/apt/apt.conf.d/52dotfiles-unattended "$unattended_policy" || true
sudo rmdir "$backup" 2>/dev/null || echo "Previous files saved in $backup"

if ! id -nG "$user" | tr ' ' '\n' | grep -qx systemd-journal; then
  sudo usermod -aG systemd-journal "$user"
  echo "Added $user to systemd-journal; sign in again to read system logs."
fi
sudo systemd-analyze cat-config systemd/journald.conf >/dev/null
if (( journal_changed )); then
  sudo systemctl restart systemd-journald.service
  sudo journalctl --flush
fi
sudo systemctl enable --now "${timers[@]}"
{{ end -}}
