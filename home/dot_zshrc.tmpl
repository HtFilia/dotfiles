#!/usr/bin/env zsh
# ~/.zshrc - managed by chezmoi. Machine-specific additions belong in
# ~/.zshrc.settings (read first) and ~/.zshrc.local (read last).
# shellcheck disable=all
{{- $osid := includeTemplate "osid" . }}
{{- $share := "/usr/share" }}

# Inputs read before the integrations below: command-override flags, or
# STARSHIP_CONFIG, RIPGREP_CONFIG_PATH and ATUIN_CONFIG_DIR pointing at a local
# copy of a managed configuration.
[[ -f "$HOME/.zshrc.settings" ]] && source "$HOME/.zshrc.settings"

typeset -U path PATH fpath
path=("$HOME/.local/bin" "$HOME/.cargo/bin" $path)
{{- if eq $osid "fedora" }}
# Completions for the pinned binaries of .chezmoiexternal (yazi, ya).
fpath=("$HOME/.local/share/zsh/site-functions" $fpath)
{{- end }}
export PATH
# Programs started from here (tmux, editors, Claude Code) open zsh too, even
# when the desktop session still has the SHELL it had before `chsh`.
[[ "${SHELL:t}" == zsh ]] || export SHELL="${commands[zsh]:-$SHELL}"
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export LESS="-R --mouse --wheel-lines=3"
export LANG="${LANG:-C.UTF-8}"
# groff 1.23+ emits ANSI SGR codes that col -b cannot strip; -c restores overstrike.
command -v bat &>/dev/null && command -v col &>/dev/null && export MANROFFOPT="-c" MANPAGER="sh -c 'col -bx | bat -l man -p'"
# Kitty and tmux advertise true color; SSH need not forward COLORTERM.
[[ "$TERM" == xterm-kitty || "$TERM" == tmux-256color ]] && export COLORTERM=truecolor
export BAT_THEME="gruvbox-dark"
export RIPGREP_CONFIG_PATH="${RIPGREP_CONFIG_PATH:-$HOME/.config/ripgrep/config}"

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
[[ -e "$HISTFILE" ]] || (umask 077; : >"$HISTFILE")
setopt EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_IGNORE_DUPS HIST_IGNORE_SPACE
setopt HIST_VERIFY SHARE_HISTORY APPEND_HISTORY
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT INTERACTIVE_COMMENTS
setopt NO_BEEP PROMPT_SUBST

autoload -Uz compinit
compinit
bindkey -e
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Source a file only if it and every parent directory belong to root or to
# this user and are not writable by group or others. Distribution plugins
# under /usr/share belong to root.
zmodload -F zsh/stat b:zstat
_dotfiles_safe_source() {
  local file="$1" directory
  local -a owner mode
  [[ -f "$file" ]] || return 1
  directory="${file:A}"
  while true; do
    zstat -A owner +uid -- "$directory" 2>/dev/null || return 1
    zstat -o -A mode +mode -- "$directory" 2>/dev/null || return 1
    [[ "$owner" == 0 || "$owner" == "$UID" ]] || return 1
    (( (8#$mode & 8#022) == 0 )) || return 1
    [[ "$directory" == / ]] && break
    directory="${directory:h}"
  done
  source "$file"
}

{{- if eq $osid "fedora" }}
# fzf-tab replaces the completion menu with fzf. It must come after compinit
# and before the plugins that wrap widgets (autosuggestions, highlighting).
if _dotfiles_safe_source "$HOME/.local/share/zsh/plugins/fzf-tab/fzf-tab.plugin.zsh"; then
  zstyle ':completion:*' menu no
  zstyle ':completion:*:descriptions' format '[%d]'
  zstyle ':completion:*:git-checkout:*' sort false
  zstyle ':fzf-tab:*' use-fzf-default-opts yes
  # < and > sit unshifted and shifted left of W on an AZERTY keyboard.
  zstyle ':fzf-tab:*' switch-group '<' '>'
  zstyle ':fzf-tab:complete:(cd|pushd|z|ls|eza|y|yazi):*' fzf-preview 'eza -1 --color=always --icons=always --group-directories-first -- $realpath'
  zstyle ':fzf-tab:complete:(nvim|vim|vi|bat|cat|less|code):*' fzf-preview '[[ -d $realpath ]] && eza -1 --color=always --icons=always -- $realpath || bat --color=always --style=numbers --line-range=:200 -- $realpath'
  zstyle ':fzf-tab:complete:(kill|fkill):argument-rest' fzf-preview 'ps --pid=$word -o cmd --no-headers -w -w'
  zstyle ':fzf-tab:complete:systemctl-*:*' fzf-preview 'SYSTEMD_COLORS=1 systemctl status -- $word'
  zstyle ':fzf-tab:complete:git-(add|diff|restore):*' fzf-preview 'git diff --color=always -- $word'
fi
{{- end }}

if _dotfiles_safe_source {{ $share }}/zsh-autosuggestions/zsh-autosuggestions.zsh; then
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#867462"
fi

export STARSHIP_CONFIG="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
command -v starship &>/dev/null && eval "$(starship init zsh)"
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
  # Claude Code copies this shell's aliases into the shell that runs its
  # commands and sets CLAUDECODE there. A cd that jumps to the most-used
  # matching directory when the path does not exist would run its next
  # command in the wrong place.
  [[ -n "${CLAUDECODE:-}" ]] || alias cd='z'
fi
if command -v fzf &>/dev/null; then
  eval "$(fzf --zsh)"
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border=rounded --color=bg:#292522,bg+:#403a36,fg:#ece1d7,fg+:#ece1d7,hl:#e49b5d,hl+:#ebc06d,info:#867462,prompt:#85b695,pointer:#e49b5d,marker:#85b695,spinner:#e49b5d,header:#89b3b6,border:#403a36"
  if command -v fd &>/dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  fi
  # Ctrl-t previews files, Alt-c previews directories; Ctrl-/ hides the preview.
  command -v bat &>/dev/null &&
    export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:500 -- {}' --bind 'ctrl-/:toggle-preview'"
  command -v eza &>/dev/null &&
    export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always --icons=always -- {}' --bind 'ctrl-/:toggle-preview'"
fi
command -v atuin &>/dev/null && eval "$(atuin init zsh --disable-up-arrow)"
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"
{{- if eq $osid "fedora" }}
# Ctrl+G opens navi's cheat sheets, or completes the command being typed.
command -v navi &>/dev/null && eval "$(navi widget zsh)"
{{- end }}

# Modern replacements that accept the original command's everyday arguments.
# `command NAME` or `\NAME` runs the original. Icons appear only on a terminal,
# so piped output stays plain. Claude Code's shells keep the standard commands
# (see the cd alias above and ~/.claude/dotfiles-tools.md).
if [[ -z "${CLAUDECODE:-}" ]]; then
  if command -v eza &>/dev/null; then
    _eza='eza --icons=auto --group-directories-first'
    _eza_long="$_eza --long --header --git --smart-group --time-style=long-iso"
    alias ls="$_eza" ll="$_eza_long" la="$_eza_long --all"
    alias tree="$_eza --tree" lt="$_eza --tree --level=2" ltt="$_eza --tree --level=3"
    unset _eza _eza_long
  fi
  # Highlighted like bat, but without line numbers or a pager, so output
  # copies and redirects exactly like cat.
  command -v bat &>/dev/null && alias cat='bat --paging=never --style=plain'
  command -v nvim &>/dev/null && alias vi='nvim' vim='nvim'
  command -v htop &>/dev/null && alias top='htop'
  # Hidden files too, as in the fzf widgets; .gitignore still applies.
  command -v fd &>/dev/null && alias fd='fd --hidden --exclude .git'
  alias grep='grep --color=auto'
  # grep, find and less take different arguments from rg, fd and bat, so
  # these replacements are opt-in.
  if [[ "${DOTFILES_ENABLE_COMMAND_OVERRIDES:-0}" == "1" ]]; then
    command -v bat &>/dev/null && alias less='bat'
    command -v rg &>/dev/null && alias grep='rg'
    command -v fd &>/dev/null && alias find='fd'
    alias mkdir='mkdir -p'
  fi
fi
command -v lazygit &>/dev/null && alias lg='lazygit'
{{- if eq $osid "fedora" }}
# Kitty's kittens, inside Kitty only: tmux does not pass their graphics and
# remote-control sequences through.
if [[ -n "${KITTY_WINDOW_ID:-}" && -z "${TMUX:-}" ]] && command -v kitten &>/dev/null; then
  alias s='kitten ssh' icat='kitten icat' kd='kitten diff'
fi
{{- end }}

alias g='git' gs='git status -sb' ga='git add' gaa='git add --all'
alias gc='git commit' gcm='git commit -m' gca='git commit --amend'
alias gco='git checkout' gcb='git checkout -b' gb='git branch'
alias gp='git push' gpl='git pull' gl='git log --oneline --graph --decorate'
alias gll='git log --oneline --graph --decorate --all' gd='git diff'
alias gds='git diff --staged' gst='git stash' gstp='git stash pop'
alias gstl='git stash list' gf='git fetch' gfa='git fetch --all --prune'
alias grb='git rebase' grbi='git rebase -i' gcp='git cherry-pick'
alias grs='git restore' grss='git restore --staged' grt='git rev-parse --show-toplevel'

if command -v docker &>/dev/null; then
  alias d='docker'
  alias dc='docker compose'
  alias dps={{ `'docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}"'` }}
  alias dpsa={{ `'docker ps -a --format "table {{.Names}}\t{{.Image}}\t{{.Status}}"'` }}
  alias di='docker images' dex='docker exec -it' dlog='docker logs -f'
  alias dprune='docker system prune'
fi

alias ..='cd ..' ...='cd ../..' ....='cd ../../..' -- -='cd -'
alias mkd='mkdir -p' df='df -h' du='du -h'
alias reload='exec zsh' zshconfig='$EDITOR ~/.zshrc'
alias nvimconfig='$EDITOR ~/.config/nvim'
alias dotfiles='chezmoi cd'

# Package manager shortcuts for this operating system.
{{- if eq $osid "fedora" }}
alias dnfup='sudo dnf upgrade' dnfi='sudo dnf install' dnfs='dnf search'
alias dnfrm='sudo dnf remove' dnfinfo='dnf info'
{{- else if eq $osid "debian" }}
alias aptup='sudo apt update && sudo apt upgrade'
alias apti='sudo apt install' apts='apt search' aptrm='sudo apt remove'
alias aptshow='apt show'
{{- end }}
alias free='free -h' open='xdg-open' ip='ip -color=auto' diff='diff --color=auto'
alias sc='systemctl' scu='systemctl --user' jcf='journalctl -fu'
alias jcu='journalctl -u' jcb='journalctl -b'

mkcd() { mkdir -p "$1" && cd "$1" || return; }
extract() {
  if [[ -f "$1" ]]; then
    case "$1" in
      *.tar.bz2) tar xjf "$1" ;; *.tar.gz) tar xzf "$1" ;; *.tar.xz) tar xJf "$1" ;;
      *.bz2) bunzip2 "$1" ;; *.rar) unrar x "$1" ;; *.gz) gunzip "$1" ;;
      *.tar) tar xf "$1" ;; *.tbz2) tar xjf "$1" ;; *.tgz) tar xzf "$1" ;;
      *.zip) unzip "$1" ;; *.Z) uncompress "$1" ;; *.7z) 7z x "$1" ;;
      *) echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}
fe() {
  local file
  IFS= read -r -d $'\0' file < <(fd --type f --print0 | fzf --read0 --print0 --preview 'bat --color=always --style=numbers --line-range=:500 -- {}') || return
  "${EDITOR:-nvim}" -- "$file"
}
fcd() {
  local dir
  IFS= read -r -d $'\0' dir < <(fd --type d --print0 | fzf --read0 --print0) || return
  builtin cd -- "$dir"
}
fga() {
  local file
  local -a files
  while IFS= read -r -d $'\0' file; do files+=("$file"); done < <(
    { git diff --name-only -z; git ls-files --others --exclude-standard -z; } |
      fzf --read0 --print0 --multi --preview 'git diff --color=always -- {}'
  )
  (( ${#files} )) && git add -- "${files[@]}"
}
fkill() {
  local pid
  local -a pids
  while IFS= read -r pid; do pids+=("$pid"); done < <(ps -eo pid=,args= | fzf -m | awk '{print $1}')
  (( ${#pids} )) && kill -s "${1:-TERM}" -- "${pids[@]}"
}
frg() {
  local result file line
  (( $# )) || { print -u2 'Usage: frg PATTERN'; return 1; }
  result=$(rg --json -- "$*" . | jq -r 'select(.type == "match") | [.data.path.text, .data.line_number, .data.lines.text] | @json' | fzf) || return
  [[ -n "$result" ]] || return
  IFS= read -r -d $'\0' file < <(print -r -- "$result" | jq -j '.[0], "\u0000"') || return
  line=$(print -r -- "$result" | jq -r '.[1]')
  "${EDITOR:-nvim}" "+$line" -- "$file"
}
fh() { print -z "$(fc -rln 1 | fzf --no-sort --tac --query="$*")"; }
groot() { local root; root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Not in a git repo."; return 1; }; cd "$root" || return; }
gclone() { local dest="${2:-$(basename "$1" .git)}"; git clone "$1" "$dest" && cd "$dest" || return; }
gwip() { git add -A && git commit -m "wip: $(date '+%Y-%m-%d %H:%M')"; }
gunwip() { git log -1 --format=%s | command grep -Eq "^wip: [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$" && git reset HEAD~1; }
serve() { python3 -m http.server --bind "${2:-127.0.0.1}" "${1:-8000}"; }
psg() { ps aux | grep -v grep | grep -i "$@"; }
activate() {
  if [[ -f .venv/bin/activate ]]; then source .venv/bin/activate
  elif [[ -f venv/bin/activate ]]; then source venv/bin/activate
  else echo "No .venv or venv found. Create with: uv venv"; return 1
  fi
}

if command -v uv &>/dev/null; then
  _uv_cache="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/uv-completion.zsh"
  _uv_command="${commands[uv]:A}"
  _uv_cached_command=""
  [[ ! -f "$_uv_cache.command" ]] || IFS= read -r _uv_cached_command <"$_uv_cache.command"
  if [[ ! -f "$_uv_cache" || "$_uv_command" -nt "$_uv_cache" || "$_uv_command" != "$_uv_cached_command" ]]; then
    mkdir -p "${_uv_cache:h}"
    _uv_stage=$(mktemp "$_uv_cache.XXXXXX")
    if uv generate-shell-completion zsh >"$_uv_stage"; then
      mv "$_uv_stage" "$_uv_cache"
      (umask 077; print -r -- "$_uv_command" >"$_uv_cache.command")
    else
      rm -f "$_uv_stage"
    fi
  fi
  _dotfiles_safe_source "$_uv_cache" "${_uv_cache:h}" || true
  unset _uv_cache _uv_command _uv_cached_command _uv_stage
  alias uvr='uv run' uvs='uv sync' uva='uv add' uvp='uv pip'
  alias pyi='uv pip install' pyls='uv pip list'
fi
tm() { tmux new-session -A -s "${1:-${PWD:t}}"; }
{{- if eq $osid "fedora" }}
# yazi in the current directory: quitting with q moves the shell to the
# directory yazi showed last, Q quits without moving.
if command -v yazi &>/dev/null; then
  y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)" || return
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd <"$tmp"
    [[ -n "$cwd" && "$cwd" != "$PWD" ]] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
  }
fi
{{- end }}
export GOPATH="${GOPATH:-$HOME/go}"
export GOBIN="${GOBIN:-$GOPATH/bin}"
[[ -d "$GOBIN" ]] && path+=("$GOBIN")
command -v claude &>/dev/null && alias ai='claude' air='claude --resume'
command -v tldr &>/dev/null && alias helpme='tldr'

{{- if eq $osid "fedora" }}
# A machine summary once per new Kitty window. Kitty starts each window from its own
# environment, so the exported flag only stops nested shells, exec zsh and
# editor terminals from showing it again.
if [[ -n "${KITTY_WINDOW_ID:-}" && -z "${TMUX:-}${SSH_CONNECTION:-}${CLAUDECODE:-}${DOTFILES_FASTFETCH_SHOWN:-}" ]] &&
  command -v fastfetch &>/dev/null; then
  export DOTFILES_FASTFETCH_SHOWN=1
  # The fastfetch rail needs about 50 columns; narrow tiles get two lines.
  if (( COLUMNS >= 60 )) || [[ ! -x "$HOME/.local/share/dotfiles/fetch-strip" ]]; then
    fastfetch
  else
    "$HOME/.local/share/dotfiles/fetch-strip"
  fi
fi
{{- end }}

# Final aliases, environment overrides and widgets for this machine.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
# Syntax highlighting must be loaded after widgets from fzf, atuin and local config.
_dotfiles_safe_source {{ $share }}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh || true
